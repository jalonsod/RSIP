# RSIP Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=RSIP API
ENVIRONMENT=development
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://rsip:rsip@localhost:5432/rsip
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── External APIs ────────────────────────────────────────────────────────────

# Zillow API key — obtain from https://www.zillow.com/howto/api/APIOverview.htm
# Required: no (skipped if blank)
ZILLOW_API_KEY=

# Realtor.com API key — obtain from https://rapidapi.com/apidojo/api/realty-in-us
# Required: no (skipped if blank)
REALTOR_API_KEY=

# LMS (Lead Management System) — internal API
# Development: use the lms-mock Docker service (LMS_API_URL=http://lms-mock:8001, LMS_API_KEY=lms-dev-mock-key-rsip)
# Production: obtain the base URL and API key from the LMS system owner
# Auth mechanism: X-API-Key request header
# Required: no (skipped if blank)
LMS_API_URL=http://localhost:8001
LMS_API_KEY=lms-dev-mock-key-rsip

# Crexy API key — obtain from Crexy account dashboard
# Required: no (skipped if blank)
CREXY_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API
ALLOWED_ORIGINS=http://localhost:3000
